# Copy this file to .env and fill in your own values. Never commit .env.

# Telegram bot used for intrusion alerts (leave blank to disable alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Firebase service account key and storage bucket for cloud backup
FIREBASE_CREDENTIALS=firebase-credentials.json
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
